{
  "discovery": {
    "refresh_interval_secs": 60,
    "polymarket": {
      "enabled": true,
      "sports": [
        {
          "sport": "Tennis",
          "competitions": [
            "atp"
          ]
        }
      ]
    },
    "orbitexch": {
      "enabled": true,
      "sports": [
        {
          "sport": "Tennis",
          "competitions": [
            "Men's Wimbledon 2026"
          ]
        }
      ]
    },
    "sharpexch": {
      "enabled": true,
      "sports": [
        {
          "sport": "Tennis",
          "competitions": [
            "Men's Wimbledon 2026"
          ]
        }
      ]
    }
  },
  "matching": {
    "min_similarity": 1,
    "sport_aliases": {},
    "competition_aliases": {
      "atp": "ATP",
      "Men's Wimbledon 2026": "ATP"
    },
    "competition_max_matches": {
      "ATP": 1
    }
  },
  "venues": {
    "polymarket": {
      "enabled": true,
      "clob_url": "https://clob.polymarket.com",
      "ws_url": "wss://ws-subscriptions-clob.polymarket.com/ws/"
    },
    "orbitexch": {
      "enabled": false,
      "base_url": "https://www.orbitexch.com",
      "headless": false,
      "page_load_timeout_sec": 120,
      "staleness_timeout_sec": 300
    },
    "sharpexch": {
      "enabled": true,
      "base_url": "https://portal.sharpxch.com",
      "login_url": "https://sharpxch.com/player/",
      "headless": false,
      "page_load_timeout_sec": 120,
      "staleness_timeout_sec": 300
    }
  },
  "arbitrage": {
    "share": 40,
    "max_leg_share": 100,
    "fx": 1.33
  },
  "risk": {
    "match_tp": 0.05,
    "match_sl": -0.05
  },
  "execution": {
    "tracking_timeout_sec": 30
  },
  "web": {
    "enabled": true,
    "host": "127.0.0.1",
    "port": 3001,
    "start_halted": true
  },
  "strategy": {
    "enabled": true,
    "log_evaluations": false,
    "strategies": {
      "mean_rebate": {
        "arbitrage_tree": {
          "self_hits": {
            "signal": "pre_match"
          },
          "checktion": [
            {
              "type": "mean_rebate",
              "params": {
                "min_rate": -1
              }
            },
            {
              "type": "require_cross_venue"
            }
          ],
          "actions": [
            {
              "type": "share_limit"
            },
            {
              "type": "place_bets"
            }
          ]
        },
        "compensation_tree": {
          "checktion": [
            {
              "type": "mean_rebate_recovery",
              "params": {
                "min_repaired_rebate": 0.1
              }
            }
          ],
          "actions": [
            {
              "type": "place_bets",
              "params": {
                "intent": "recovery"
              }
            }
          ]
        }
      },
      "one_side_rebate": {
        "arbitrage_tree": {
          "self_hits": {
            "signal": "pre_match"
          },
          "checktion": [
            {
              "type": "one_side_rebate",
              "params": {
                "min_rate": 0.01
              }
            },
            {
              "type": "require_cross_venue"
            }
          ],
          "actions": [
            {
              "type": "share_limit"
            },
            {
              "type": "place_bets"
            }
          ]
        }
      }
    },
    "bindings": [
      {
        "scope": "competition:ATP",
        "strategy_id": "mean_rebate"
      }
    ]
  },
  "debug": {
    "enabled": true,
    "overrides": {
      "skip_execution": {
        "enabled": false,
        "value": true,
        "description": "smoke 不真下单"
      }
    },
    "mock_data": {}
  }
}
