{
  "_doc": "Risk service test cases — way_rebate calculations, risk checks, position loading",

  "position_leg_polymarket_home": {
    "_doc": "Polymarket home: size=100, price=0.4 → profit=60, loss=40",
    "venue": "polymarket",
    "market_type": "home",
    "size": 100.0,
    "price": 0.4,
    "expected_profit": 60.0,
    "expected_loss": 40.0
  },

  "position_leg_orbitexch_away": {
    "_doc": "OrbitExch away: size=50, odds=2.5 → profit=75, loss=50",
    "venue": "orbitexch",
    "market_type": "away",
    "size": 50.0,
    "price": 2.5,
    "expected_profit": 75.0,
    "expected_loss": 50.0
  },

  "position_leg_with_override": {
    "_doc": "Leg with profit/loss override from API data",
    "venue": "polymarket",
    "market_type": "home",
    "size": 30.0,
    "price": 0.55,
    "profit_override": 12.5,
    "loss_override": 17.5,
    "expected_profit": 12.5,
    "expected_loss": 17.5
  },

  "case_basic_two_way": {
    "_doc": "基础双向套利: Polymarket home + OrbitExch away (来自 position.py docstring)",
    "share": 100.0,
    "pair_id": "pair-basic-2way",
    "legs": [
      {"venue": "polymarket", "market_type": "home", "size": 100.0, "price": 0.4},
      {"venue": "orbitexch", "market_type": "away", "size": 50.0, "price": 2.5}
    ],
    "expected_way_rebate": {
      "home": 0.10,
      "away": 0.35
    },
    "_explanation": {
      "home_wins": "poly_home profit 60 - orbit_away loss 50 = +10 → 10/100 = 0.10",
      "away_wins": "orbit_away profit 75 - poly_home loss 40 = +35 → 35/100 = 0.35"
    }
  },

  "case_negative_rebate": {
    "_doc": "有方向亏损的套利: 赔率不利",
    "share": 30.0,
    "pair_id": "pair-neg-rebate",
    "legs": [
      {"venue": "polymarket", "market_type": "home", "size": 30.0, "price": 0.6},
      {"venue": "orbitexch", "market_type": "away", "size": 20.0, "price": 2.0}
    ],
    "expected_way_rebate": {
      "home": -0.2667,
      "away": 0.0667
    },
    "_explanation": {
      "home_wins": "poly profit 30*0.4=12 - orbit loss 20 = -8 → -8/30 = -0.2667",
      "away_wins": "orbit profit 20*1=20 - poly loss 30*0.6=18 = +2 → 2/30 = 0.0667"
    }
  },

  "case_three_way_with_draw": {
    "_doc": "三向市场: home + away + draw",
    "share": 100.0,
    "pair_id": "pair-3way",
    "legs": [
      {"venue": "polymarket", "market_type": "home", "size": 100.0, "price": 0.35},
      {"venue": "orbitexch",  "market_type": "away", "size": 40.0, "price": 3.0},
      {"venue": "orbitexch",  "market_type": "draw", "size": 30.0, "price": 3.5}
    ],
    "expected_way_rebate": {
      "home": -0.05,
      "away":  0.10,
      "draw":  0.10
    },
    "_explanation": {
      "home_wins": "poly profit 65 - orbit_away loss 40 - orbit_draw loss 30 = -5 → -5/100",
      "away_wins": "orbit_away profit 80 - poly loss 35 - orbit_draw loss 30 = +10 → 10/100 (note: loss 30 not 35)",
      "draw_wins": "orbit_draw profit 75 - poly loss 35 - orbit_away loss 40 = +10 → 0 (note: 75-35-40=0, but this seems wrong. Let me recalculate.)"
    }
  },

  "case_single_leg_only": {
    "_doc": "单腿持仓 — 只有一个方向",
    "share": 100.0,
    "pair_id": "pair-single-leg",
    "legs": [
      {"venue": "polymarket", "market_type": "home", "size": 100.0, "price": 0.5}
    ],
    "expected_way_rebate_keys": ["home", "away"]
  },

  "case_no_legs": {
    "_doc": "空持仓 — 无腿",
    "share": 100.0,
    "pair_id": "pair-empty",
    "legs": [],
    "expected_way_rebate": {}
  },

  "risk_check_execution_disabled": {
    "_doc": "execution_enabled=False → 所有检查被阻止",
    "config": {
      "enabled": true,
      "execution_enabled": false,
      "match_sl": -0.10,
      "global_sl": -0.50,
      "match_tp": 0.10
    },
    "expected_allowed": false,
    "expected_reason": "Execution disabled"
  },

  "risk_check_disabled": {
    "_doc": "enabled=False → 跳过风控但允许执行",
    "config": {
      "enabled": false,
      "execution_enabled": true,
      "match_sl": -0.10,
      "global_sl": -0.50,
      "match_tp": 0.10
    },
    "expected_allowed": true,
    "expected_reason": "Risk disabled"
  },

  "risk_check_match_sl_triggered": {
    "_doc": "单场止损触发: min_way_rebate < match_sl",
    "config": {
      "enabled": true,
      "execution_enabled": true,
      "match_sl": -0.10,
      "global_sl": -0.50,
      "match_tp": 0.10
    },
    "pair_id": "pair-sl",
    "share": 30.0,
    "legs": [
      {"venue": "polymarket", "market_type": "home", "size": 30.0, "price": 0.6},
      {"venue": "orbitexch", "market_type": "away", "size": 20.0, "price": 2.0}
    ],
    "expected_allowed": false,
    "expected_match_blocked": true
  },

  "risk_check_match_tp_triggered": {
    "_doc": "单场止盈触发: 所有方向 way_rebate >= match_tp",
    "config": {
      "enabled": true,
      "execution_enabled": true,
      "match_sl": -0.50,
      "global_sl": -1.00,
      "match_tp": 0.05
    },
    "pair_id": "pair-tp",
    "share": 100.0,
    "legs": [
      {"venue": "polymarket", "market_type": "home", "size": 100.0, "price": 0.4},
      {"venue": "orbitexch", "market_type": "away", "size": 50.0, "price": 2.5}
    ],
    "expected_allowed": false,
    "expected_tp_blocked": true
  },

  "risk_check_global_sl_triggered": {
    "_doc": "全局累计止损: 多场比赛 min_way_rebate 之和 < global_sl",
    "config": {
      "enabled": true,
      "execution_enabled": true,
      "match_sl": -0.50,
      "global_sl": -0.30,
      "match_tp": 1.00
    },
    "matches": [
      {
        "pair_id": "pair-g1",
        "legs": [
          {"venue": "polymarket", "market_type": "home", "size": 30.0, "price": 0.7},
          {"venue": "orbitexch", "market_type": "away", "size": 25.0, "price": 1.5}
        ]
      },
      {
        "pair_id": "pair-g2",
        "legs": [
          {"venue": "polymarket", "market_type": "home", "size": 30.0, "price": 0.7},
          {"venue": "orbitexch", "market_type": "away", "size": 25.0, "price": 1.5}
        ]
      }
    ],
    "check_pair_id": "pair-g1",
    "expected_allowed": false,
    "expected_global_blocked": true
  },

  "risk_check_all_pass": {
    "_doc": "所有检查通过",
    "config": {
      "enabled": true,
      "execution_enabled": true,
      "match_sl": -0.50,
      "global_sl": -1.00,
      "match_tp": 1.00
    },
    "pair_id": "pair-pass",
    "share": 100.0,
    "legs": [
      {"venue": "polymarket", "market_type": "home", "size": 100.0, "price": 0.4},
      {"venue": "orbitexch", "market_type": "away", "size": 50.0, "price": 2.5}
    ],
    "expected_allowed": true
  },

  "risk_check_match_sl_override": {
    "_doc": "单场止损覆盖: 特定 pair 使用不同的 sl 阈值",
    "config": {
      "enabled": true,
      "execution_enabled": true,
      "match_sl": -0.50,
      "global_sl": -1.00,
      "match_tp": 1.00,
      "match_overrides": {
        "pair-override": -0.05
      }
    },
    "pair_id": "pair-override",
    "share": 100.0,
    "legs": [
      {"venue": "polymarket", "market_type": "home", "size": 100.0, "price": 0.55},
      {"venue": "orbitexch", "market_type": "away", "size": 60.0, "price": 2.0}
    ],
    "expected_allowed": false,
    "expected_match_blocked": true,
    "_explanation": "min_way_rebate ~ -0.15, override sl=-0.05 → blocked (default sl=-0.50 would pass)"
  },

  "load_polymarket_positions": {
    "_doc": "从 Polymarket API 加载持仓数据",
    "positions": [
      {"event_id": "evt-1", "market_type": "home", "size": 50.0, "avg_price": 0.45, "profit_if_win": 27.5, "loss_if_lose": 22.5},
      {"event_id": "evt-1", "market_type": "away", "size": 30.0, "avg_price": 0.55, "profit_if_win": 13.5, "loss_if_lose": 16.5},
      {"event_id": "evt-unknown", "market_type": "home", "size": 20.0, "avg_price": 0.3}
    ],
    "pair_mapping": {"evt-1": "pair-load-1"},
    "expected_count": 2
  },

  "load_orbitexch_bets": {
    "_doc": "从 OrbitExch API 加载订单数据",
    "bets": [
      {"marketId": "mkt-1", "selectionId": 101, "sizeMatched": 25.0, "averagePrice": 2.5, "price": 1.01, "side": "BACK", "marketProfit": 37.5, "marketLiability": 25.0},
      {"marketId": "mkt-1", "selectionId": 102, "sizeMatched": 15.0, "averagePrice": 3.0, "price": 1.01, "side": "BACK", "marketProfit": 30.0, "marketLiability": 15.0},
      {"marketId": "mkt-unknown", "selectionId": 999, "sizeMatched": 10.0, "averagePrice": 2.0, "price": 1.01, "side": "BACK", "marketProfit": 10.0, "marketLiability": 10.0}
    ],
    "pair_mapping": {"mkt-1": "pair-load-2"},
    "selection_mappings": {"pair-load-2": {"101": "home", "102": "away"}},
    "expected_count": 2
  },

  "msgbus_session_complete": {
    "_doc": "SessionComplete 消息处理 — 从 odds_service 刷新持仓并发布 way_rebate",
    "pair_id": "pair-session",
    "polymarket_positions": [
      {"event_id": "evt-s1", "market_type": "home", "size": 30.0, "avg_price": 0.5, "profit_if_win": 15.0, "loss_if_lose": 15.0}
    ],
    "orbitexch_bets": [
      {"marketId": "mkt-s1", "selectionId": 201, "sizeMatched": 20.0, "averagePrice": 2.0, "price": 1.01, "side": "BACK", "marketProfit": 20.0, "marketLiability": 20.0}
    ],
    "mappings": {
      "polymarket_pair_mapping": {"evt-s1": "pair-session"},
      "orbitexch_pair_mapping": {"mkt-s1": "pair-session"},
      "selection_mappings": {"pair-session": {"201": "away"}}
    }
  }
}
