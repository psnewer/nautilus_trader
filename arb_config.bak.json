{
  "_doc": "ArbConfig 示例 — Tennis × OE ATP Stuttgart 2026 × PM atp,debug.skip_execution smoke。详见 docs/arbitrage/architectures/_cross-cutting/configuration.md。凭证不要写这里,走 .env。",
  "discovery": {
    "enabled": true,
    "refresh_interval_secs": 60,
    "polymarket": {
      "enabled": true,
      "sports": [
        {
          "sport": "Tennis",
          "competitions": [
            "atp"
          ]
        }
      ]
    },
    "orbitexch": {
      "enabled": true,
      "sports": [
        {
          "sport": "Tennis",
          "competitions": [
            "ATP Stuttgart 2026"
          ]
        }
      ]
    }
  },
  "matching": {
    "enabled": true,
    "min_similarity": 1,
    "sport_aliases": {},
    "competition_aliases": {
      "atp": "ATP",
      "ATP Stuttgart 2026": "ATP"
    },
    "competition_max_matches": {
      "ATP": 1
    }
  },
  "venues": {
    "polymarket": {
      "clob_url": "https://clob.polymarket.com",
      "ws_url": "wss://ws-subscriptions-clob.polymarket.com/ws/"
    },
    "orbitexch": {
      "base_url": "https://www.orbitexch.com",
      "headless": false,
      "page_load_timeout_sec": 120
    }
  },
  "risk": {
    "share": 40,
    "fx": 1.33,
    "match_tp": 0.05,
    "match_sl": -0.05
  },
  "execution": {
    "tracking_timeout_sec": 30,
    "health_check_interval_sec": 120
  },
  "web": {
    "_doc": "Step 7 控制台(architectures/web/architecture.md §8):TradingState 启停 + 配置编辑,后端 JSON/WS。默认关闭;host 默认 127.0.0.1 只绑本机,暴露公网需显式改。start_halted: 控制台启用时 boot 即 HALTED(真金安全默认,操作员点 Start 才放行)",
    "enabled": true,
    "host": "127.0.0.1",
    "port": 3001,
    "start_halted": true
  },
  "strategy": {
    "_doc": "slice 9(#49)落 mean_rebate 策略:checktion 短路 AND(pre_match → mean_rebate);actions 数组依次执行(share_limit 缩量/调整 candidates → candi_select 选择内部最大 share_if_wins 最高的 candidate → place_bets 下单)",
    "enabled": true,
    "log_evaluations": false,
    "signals": {},
    "strategies": {
      "mean_rebate": {
        "arbitrage_tree": {
          "checktion": [
            {
              "type": "pre_match"
            },
            {
              "type": "mean_rebate",
              "params": {
                "min_rate": 0.01
              }
            }
          ],
          "actions": [
            {
              "type": "share_limit",
              "params": {
                "max_leg_share": 100,
                "share": 40
              }
            },
            {
              "type": "candi_select"
            },
            {
              "type": "place_bets",
              "params": {
                "share": 40
              }
            }
          ]
        }
      },
      "one_side_rebate": {
        "arbitrage_tree": {
          "checktion": [
            {
              "type": "pre_match"
            },
            {
              "type": "one_side_rebate",
              "params": {
                "min_rate": 0.01,
                "share": 40
              }
            }
          ],
          "actions": [
            {
              "type": "share_limit",
              "params": {
                "max_leg_share": 40,
                "share": 40
              }
            },
            {
              "type": "candi_select"
            },
            {
              "type": "place_bets",
              "params": {
                "share": 40
              }
            }
          ]
        }
      }
    },
    "bindings": [
      {
        "scope": "competition:ATP",
        "strategy_id": "mean_rebate"
      }
    ]
  },
  "debug": {
    "_doc": "smoke 用:skip_execution=true 时 SkipExecution{PM,OE}Client 拦 _submit_order 直接 mock 全成,不真上链。生产跑改 enabled=false 或整段删",
    "enabled": true,
    "overrides": {
      "skip_execution": {
        "enabled": true,
        "value": true,
        "description": "smoke 不真下单"
      }
    },
    "mock_data": {}
  }
}
